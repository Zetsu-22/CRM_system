{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "CRM: Migrate DB",
      "type": "shell",
      "command": "powershell",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "${workspaceFolder}\\run.ps1",
        "-PgPassword",
        "123",
        "-SkipStart"
      ],
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "shared",
        "group": "crm"
      }
    },
    {
      "label": "CRM: Backend",
      "type": "shell",
      "command": "dotnet",
      "args": [
        "run",
        "--project",
        "${workspaceFolder}\\CrmSystem.Api\\CrmSystem.Api.csproj"
      ],
      "isBackground": true,
      "problemMatcher": {
        "owner": "crm-backend",
        "pattern": {
          "regexp": "^$"
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": "Building\\.\\.\\.",
          "endsPattern": "Now listening on:"
        }
      },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "group": "crm"
      },
      "dependsOn": ["CRM: Migrate DB"]
    },
    {
      "label": "CRM: Frontend",
      "type": "shell",
      "command": "npm.cmd",
      "args": [
        "run",
        "dev"
      ],
      "options": {
        "cwd": "${workspaceFolder}\\crm-web"
      },
      "isBackground": true,
      "problemMatcher": {
        "owner": "crm-frontend",
        "pattern": {
          "regexp": "^$"
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": "VITE",
          "endsPattern": "Local:"
        }
      },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "group": "crm"
      }
    },
    {
      "label": "CRM: Start All",
      "dependsOn": ["CRM: Backend", "CRM: Frontend"],
      "dependsOrder": "parallel",
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      }
    }
  ]
}
