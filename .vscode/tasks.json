{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "CRM: Run (one command)",
      "type": "shell",
      "command": "powershell",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "${workspaceFolder}\\run.ps1"
      ],
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "new"
      }
    },
    {
      "label": "CRM: Run Backend",
      "type": "shell",
      "command": "dotnet",
      "args": [
        "run",
        "--project",
        "${workspaceFolder}\\CrmSystem.Api\\CrmSystem.Api.csproj"
      ],
      "problemMatcher": "$msCompile",
      "presentation": {
        "reveal": "always",
        "panel": "new"
      }
    },
    {
      "label": "CRM: Run Frontend",
      "type": "shell",
      "command": "npm.cmd",
      "options": {
        "cwd": "${workspaceFolder}\\crm-web"
      },
      "args": [
        "run",
        "dev"
      ],
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "new"
      }
    }
  ]
}
