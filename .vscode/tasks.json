{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "CRM: Kill Backend",
      "type": "shell",
      "command": "powershell",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-Command",
        "Get-CimInstance Win32_Process -Filter \\\"name='dotnet.exe'\\\" | Where-Object { $_.CommandLine -like '*CrmSystem.Api*' } | ForEach-Object { Write-Host \\\"Killing PID $($_.ProcessId)...\\\"; Stop-Process -Id $_.ProcessId -Force -ErrorAction SilentlyContinue }; Start-Sleep -Seconds 1; Write-Host 'Done.'"
      ],
      "problemMatcher": [],
      "presentation": {
        "reveal": "silent",
        "panel": "shared",
        "group": "crm"
      }
    },
    {
      "label": "CRM: Build",
      "type": "shell",
      "command": "dotnet",
      "args": [
        "build",
        "${workspaceFolder}\\CrmSystem.slnx"
      ],
      "problemMatcher": "$msCompile",
      "presentation": {
        "reveal": "always",
        "panel": "shared",
        "group": "crm"
      },
      "dependsOn": ["CRM: Kill Backend"]
    },
    {
      "label": "CRM: Migrate DB",
      "type": "shell",
      "command": "powershell",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "${workspaceFolder}\\run.ps1",
        "-PgPassword",
        "123",
        "-SkipStart"
      ],
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "shared",
        "group": "crm"
      }
    },
    {
      "label": "CRM: Backend",
      "type": "shell",
      "command": "dotnet",
      "args": [
        "run",
        "--no-build",
        "--project",
        "${workspaceFolder}\\CrmSystem.Api\\CrmSystem.Api.csproj"
      ],
      "isBackground": true,
      "problemMatcher": {
        "owner": "crm-backend",
        "pattern": {
          "regexp": "^$"
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": "Now listening on:|Application started",
          "endsPattern": "Now listening on:"
        }
      },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "group": "crm"
      },
      "dependsOn": ["CRM: Build", "CRM: Migrate DB"],
      "dependsOrder": "sequence"
    },
    {
      "label": "CRM: Frontend",
      "type": "shell",
      "command": "npm.cmd",
      "args": [
        "run",
        "dev",
        "--",
        "--open"
      ],
      "options": {
        "cwd": "${workspaceFolder}\\crm-web"
      },
      "isBackground": true,
      "problemMatcher": {
        "owner": "crm-frontend",
        "pattern": {
          "regexp": "^$"
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": "VITE",
          "endsPattern": "Local:"
        }
      },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "group": "crm"
      }
    },
    {
      "label": "CRM: Start All",
      "dependsOn": ["CRM: Backend", "CRM: Frontend"],
      "dependsOrder": "parallel",
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      }
    }
  ]
}
