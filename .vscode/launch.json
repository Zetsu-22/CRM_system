{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "CRM: Start All (F5)",
      "type": "node",
      "request": "launch",
      "preLaunchTask": "CRM: Start All",
      "program": "${workspaceFolder}/crm-web/node_modules/.bin/vite",
      "runtimeExecutable": "node",
      "cwd": "${workspaceFolder}/crm-web",
      "console": "integratedTerminal",
      "serverReadyAction": {
        "action": "openExternally",
        "pattern": "Local:\\s+(https?://localhost:\\d+)"
      }
    }
  ]
}
